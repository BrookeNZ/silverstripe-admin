{
  "name": "silverstripe-cms-pages",
  "version": "0.0.0",
  "description": "The Pages section of the Silverstripe admin: page tree and page edit form",
  "keywords": [
    "pilet"
  ],
  "devDependencies": {
    "@silverstripe/admin-patterns": "file:../../patterns",
    "@silverstripe/admin-shell": "file:../../shell/dist/emulator/silverstripe-admin-shell-1.0.0.tgz",
    "@types/node": "^24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "happy-dom": "^20.14.5",
    "piral-cli": "1.12.4",
    "piral-cli-webpack5": "1.12.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "6.30.6",
    "react-router-dom": "6.30.6",
    "tslib": "2.8.1",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "start": "pilet debug",
    "build": "pilet build --target ../../dist/pilets/pages/index.js --schema v2",
    "upgrade": "pilet upgrade",
    "postinstall": "pilet declaration",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "importmap": {
    "inherit": [
      "@silverstripe/admin-shell"
    ],
    "imports": {}
  },
  "dependencies": {
    "@headless-tree/core": "1.7.0",
    "@headless-tree/react": "1.7.0",
    "@tanstack/react-virtual": "3.14.13"
  },
  "source": "src/index.tsx",
  "private": true
}
